APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional: release/version identifier (shown in /health)
APP_VERSION=
# Debug-only: enable /api/debug/wordsearch logger endpoint
WORDSEARCH_DEBUG_LOGGER_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# Cache (use Redis in production / scaling)
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
# Queue (use Redis workers; sync is only for simple local dev)
QUEUE_CONNECTION=redis
# Queue priorities (optional)
QUEUE_HIGH=high
QUEUE_DEFAULT=default
QUEUE_LOW=low
# Optional: enable background execution for heavy console work
ANALYTICS_QUEUE_ENABLED=false
REFERRALS_PAYOUTS_QUEUE_ENABLED=false
# Sessions (Redis required for horizontal scaling)
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Redis (enterprise defaults)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_USERNAME=null
REDIS_PORT=6379
# Redis DB separation (supported by config/database.php)
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Third-Party Services

# Stripe (Payments & Subscriptions)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOKEN=

# Stripe Connect (Referral payouts to bank accounts)
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_COUNTRY=CA
STRIPE_CONNECT_AUTO_PAYOUT_MIN=25
STRIPE_CONNECT_PAYOUT_SCHEDULE=manual
STRIPE_CONNECT_CURRENCY=cad

# Printful (Merch Fulfillment)
PRINTFUL_API_KEY=
PRINTFUL_WEBHOOK_TOKEN=

# OpenAI (AI Insights)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# DeepSeek AI (AI Insights)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Sentry (error monitoring)
SENTRY_LARAVEL_DSN=
# 0.0 disables tracing; 0.1 = 10% of requests
SENTRY_TRACES_SAMPLE_RATE=0.0
